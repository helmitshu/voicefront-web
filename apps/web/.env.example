# Base URL of the VoiceFront API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:4000
# "Continue with Google" button (Google Identity Services). Must be the
# same OAuth client ID the API verifies against (GOOGLE_CLIENT_ID there).
# Leave blank to hide the button; email sign-in/sign-up keeps working.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
