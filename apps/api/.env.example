# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000
# Set to "1" when running behind a reverse proxy (Nginx, Fly, Render, ...)
TRUST_PROXY=0

# --- Database ---
# NOTE (Windows): do NOT wrap this value in quotes — Prisma's parser treats
# them as part of the URL and fails validation (P1012).
# Host port 5433 maps to the voicefront-db container (see docker-compose.yml).
DATABASE_URL=postgresql://voicefront:voicefront@localhost:5433/voicefront?schema=public

# --- Auth ---
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-32+-char-secret!!
ACCESS_TOKEN_TTL=7d

# --- Voice provider (platform-level; never exposed to tenants) ---
# Shared secret you configure on the provider's "server URL" for webhooks.
# Generate with: openssl rand -hex 24
VAPI_WEBHOOK_SECRET=change-me-webhook-secret-123456
# Public (browser) key from your provider dashboard. Used only to power the
# in-browser simulator; it is delivered to authenticated tenants at runtime
# and is safe to expose, unlike the private API key (which this app never needs).
VAPI_PUBLIC_KEY=

# Public https URL of this API (your ngrok URL in local dev). Required for
# voice booking tool-calls on BROWSER test calls; phone calls fall back to
# the number-level Server URL you configure in the Vapi dashboard.
# PUBLIC_API_URL=https://your-subdomain.ngrok.io

# --- Founder admin panel ---
# Comma-separated emails that can open /admin (full cross-tenant control).
PLATFORM_ADMIN_EMAILS=

# --- Observability ---
# Structured-log verbosity: fatal|error|warn|info|debug|trace (default info).
LOG_LEVEL=info
# Sentry error reporting. Leave blank to keep it off; paste your project DSN to
# turn on error alerts. Optionally override the environment tag shown in Sentry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
