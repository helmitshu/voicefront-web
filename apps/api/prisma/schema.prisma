generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Industry {
  CLINIC
  CONSTRUCTION
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum Role {
  OWNER
  MANAGER
  AGENT
}

enum CallStatus {
  COMPLETED
  FORWARDED
  VOICEMAIL
  FAILED
  UNKNOWN
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AppointmentSource {
  VOICE_AGENT
  MANUAL
}

enum CalendarProvider {
  GOOGLE
  MICROSOFT
}

enum WaitlistStatus {
  /// Still waiting for a slot to open.
  WAITING
  /// We texted them about an opening; awaiting their move.
  NOTIFIED
  /// They booked (manually marked, or a later booking matched).
  CONVERTED
  /// Removed by staff or aged out.
  CANCELLED
}

/// How fast a captured trades job needs a human. EMERGENCY fires an instant
/// owner alert; the dashboard sorts EMERGENCY/URGENT to the top of the queue.
enum JobUrgency {
  EMERGENCY
  URGENT
  ROUTINE
}

/// Field-service-management systems a tenant can connect (the FSM_INTEGRATION
/// feature). Captured jobs are pushed into whichever one they run on.
enum FsmProvider {
  SERVICETITAN
  JOBBER
  HOUSECALL
}

/// Health of an FSM connection.
enum FsmConnectionStatus {
  CONNECTED
  ERROR
  DISCONNECTED
}

/// Lifecycle of an on-call dispatch session (one per emergency job dispatched).
enum DispatchStatus {
  /// Actively ringing the roster, escalating on no-answer.
  NOTIFYING
  /// A tech accepted; the customer is being told help is coming.
  ACCEPTED
  /// Nobody accepted — fell through to the owner as a final alert.
  EXHAUSTED
  /// Manually stopped (e.g. the job was handled another way).
  CANCELLED
}

/// Outcome of ringing one roster contact during a dispatch.
enum DispatchAttemptStatus {
  CALLING
  NO_ANSWER
  DECLINED
  ACCEPTED
  FAILED
}

/// Lifecycle of a captured job in the trades triage queue.
enum JobStatus {
  /// Just captured by the receptionist; nobody has acted yet.
  NEW
  /// Someone reached back out to the caller.
  CONTACTED
  /// Turned into a booked visit / estimate.
  SCHEDULED
  /// Done, or no longer relevant.
  CLOSED
}

model Tenant {
  id                 String             @id @default(cuid())
  companyName        String             @map("company_name")
  /// White-label identifier; maps to `<slug>.yourplatform.com` in production.
  slug               String             @unique
  industry           Industry
  subscriptionStatus SubscriptionStatus @default(TRIALING) @map("subscription_status")
  /// Operator-set suspension. When true: users can't log in and the receptionist
  /// refuses calls. Distinct from billing status and from a hard delete.
  isBlocked          Boolean            @default(false) @map("is_blocked")
  /// Tenant-facing profit markup applied to provider call costs, in basis
  /// points (5000 = +50%). Adjustable per tenant by the platform operator.
  markupBps          Int                @default(5000) @map("markup_bps")
  /// Hard cap on answered call minutes per calendar month. Protects the shared
  /// provider account: once a tenant crosses this, their receptionist stops
  /// answering until the month rolls over (or the operator raises the cap for
  /// a higher tier). Enforced per call in the assistant-request webhook.
  monthlyMinuteLimit Int                @default(500) @map("monthly_minute_limit")
  /// Operator entitlement: when true the receptionist books across multiple
  /// Providers/Services; when false it's a single shared calendar (the simple
  /// case) regardless of any Providers defined. Set by the platform admin.
  multiProviderEnabled  Boolean         @default(false) @map("multi_provider_enabled")
  /// When true, the customer may flip `multiProviderEnabled` themselves from
  /// their dashboard; otherwise only the platform admin controls it.
  multiProviderSelfManage Boolean       @default(false) @map("multi_provider_self_manage")
  /// Soft-delete marker. Set when an operator "deletes" a workspace: the tenant
  /// is blocked (no login, no calls) and hidden, but its data is kept so the
  /// delete is recoverable. A retention job hard-deletes (purges) tenants that
  /// have been soft-deleted past the recovery window. Null = live.
  deletedAt          DateTime?          @map("deleted_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  users         User[]
  onboarding    OnboardingStatus?
  agentSettings AgentSettings?
  callLogs      CallLog[]
  appointments  Appointment[]
  documents     Document[]
  providers     Provider[]
  services      Service[]
  waitlist      Waitlist[]
  reactivationLogs ReactivationLog[]
  calendarConnections CalendarConnection[]
  blockedCallers BlockedCaller[]
  screenedCalls  ScreenedCallLog[]
  jobRequests   JobRequest[]
  features      TenantFeature[]
  dispatches    Dispatch[]
  fsmConnections FsmConnection[]

  @@map("tenants")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         Role     @default(OWNER)
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("users")
}

model OnboardingStatus {
  id                   String    @id @default(cuid())
  tenantId             String    @unique @map("tenant_id")
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hasConfiguredProfile Boolean   @default(false) @map("has_configured_profile")
  hasConfiguredPrompt  Boolean   @default(false) @map("has_configured_prompt")
  hasTestedVoice       Boolean   @default(false) @map("has_tested_voice")
  /// True once setup is complete and the receptionist is live for callers.
  isActive             Boolean   @default(false) @map("is_active")
  completedAt          DateTime? @map("completed_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("onboarding_status")
}

model AgentSettings {
  id                 String   @id @default(cuid())
  tenantId           String   @unique @map("tenant_id")
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Vapi assistant ID assigned by founder during customer setup. Null until assigned.
  /// When set, syncs all agent settings to this assistant on save.
  assistantId        String?  @map("assistant_id")
  /// Receptionist persona name spoken on calls (e.g. "Maya").
  displayName        String   @default("Maya") @map("display_name")
  /// Tenant-editable instructions; composed with runtime context per call.
  systemPrompt       String   @db.Text @map("system_prompt")
  firstMessage       String   @map("first_message")
  voicemailGreeting  String   @db.Text @map("voicemail_greeting")
  /// JSON: { mon..sun: { enabled, open: "HH:MM", close: "HH:MM" } }
  businessHours      Json     @map("business_hours")
  /// JSON: [{ id, label, number(E.164), whenToUse }] — drives live transfers.
  forwardingNumbers  Json     @default("[]") @map("forwarding_numbers")
  timezone           String   @default("America/New_York")
  /// E.164 number assigned by the platform operator; maps inbound calls
  /// to this tenant in the webhook. Null until a number is provisioned.
  inboundPhoneNumber String?  @unique @map("inbound_phone_number")
  voiceProvider      String   @default("vapi") @map("voice_provider")
  /// "Emma" (Vapi V2) — warm, conversational, the most human-sounding match
  /// for the default "Maya" persona. For provider "11labs" this holds an
  /// ElevenLabs voice ID instead.
  voiceId            String   @default("Emma") @map("voice_id")
  /// Ambient audio mixed into calls: "office" | "off" — matches the
  /// provider's backgroundSound field. Subtle office ambience makes the
  /// receptionist sound like a real front desk.
  backgroundSound    String   @default("office") @map("background_sound")
  /// When true, the receptionist proactively offers the list of providers and
  /// asks the caller to pick one. Default false = book the first available
  /// qualified provider and only honor a specific request if the caller names
  /// someone. Ignored for single-provider (or no-provider) businesses.
  offerProviderChoice Boolean @default(false) @map("offer_provider_choice")

  /// Average revenue per appointment in whole dollars. Powers the ROI dashboard
  /// (estimated revenue the receptionist captured). Owner-editable.
  avgAppointmentValue Int     @default(150) @map("avg_appointment_value")

  /// Spam screening: when true the receptionist refuses calls that arrive with
  /// no caller ID (withheld / anonymous). OFF by default and strictly opt-in —
  /// many legitimate customers withhold their number, so we never screen them
  /// out unless the owner deliberately turns this on. The explicit per-tenant
  /// block list (BlockedCaller) is always active regardless of this flag.
  rejectAnonymousCallers Boolean @default(false) @map("reject_anonymous_callers")

  // ── Call length & timing ─────────────────────────────────────────────────
  /// Hard ceiling on a single call's length, in seconds. A safety backstop, not
  /// a target — normal calls end naturally long before this. Owner-editable with
  /// a sane floor so it can never be set low enough to cut a real booking short.
  maxCallDurationSeconds Int    @default(600) @map("max_call_duration_seconds")
  /// End the call after this many seconds of total silence (dead-air robocalls).
  /// Floored well above a natural pause so it never hangs up on a live caller.
  silenceTimeoutSeconds  Int    @default(30)  @map("silence_timeout_seconds")
  /// Optional custom closing line the receptionist uses to wrap up gracefully as
  /// a call runs long. Null = a sensible built-in default. Soft/behavioural —
  /// steers the agent to a warm close, never an abrupt cut.
  wrapUpMessage          String? @db.Text @map("wrap_up_message")

  // ── SMS notifications ────────────────────────────────────────────────────
  /// Master switch. SMS only fires when the platform has Twilio configured AND
  /// this is true. Tenants opt in — default off so nobody gets surprise texts.
  smsEnabled              Boolean  @default(false) @map("sms_enabled")
  /// Send a confirmation SMS immediately after a booking is made.
  smsConfirmation         Boolean  @default(true)  @map("sms_confirmation")
  /// Send a reminder SMS 24 hours before the appointment.
  smsReminder24h          Boolean  @default(true)  @map("sms_reminder_24h")
  /// Send a reminder SMS 1 hour before the appointment.
  smsReminder1h           Boolean  @default(false) @map("sms_reminder_1h")
  /// Custom confirmation message. Null = use platform default.
  /// Variables: {customerName} {businessName} {date} {time}
  smsConfirmationTemplate String?  @db.Text @map("sms_confirmation_template")
  /// Custom 24-hour reminder message. Null = use platform default.
  smsReminder24hTemplate  String?  @db.Text @map("sms_reminder_24h_template")
  /// Custom 1-hour reminder message. Null = use platform default.
  smsReminder1hTemplate   String?  @db.Text @map("sms_reminder_1h_template")
  /// Text the next person on the waitlist when a slot opens (a cancellation).
  smsWaitlist             Boolean  @default(true)  @map("sms_waitlist")
  /// Custom waitlist-opening message. Null = use platform default.
  smsWaitlistTemplate     String?  @db.Text @map("sms_waitlist_template")

  // ── Reactivation / recall campaign ───────────────────────────────────────
  /// When true, a daily job texts lapsed customers an invite to rebook.
  reactivationEnabled        Boolean @default(false) @map("reactivation_enabled")
  /// A customer is "lapsed" once this many days pass since their last visit.
  reactivationInactivityDays Int     @default(180)   @map("reactivation_inactivity_days")
  /// Custom recall message. Null = use platform default.
  reactivationTemplate       String? @db.Text @map("reactivation_template")

  // ── Trades emergency routing ─────────────────────────────────────────────
  /// Text this number the moment an EMERGENCY job is captured (e.g. the on-call
  /// owner's mobile). Null = no instant alert. Requires smsEnabled + platform
  /// Twilio. E.164. Primarily for CONSTRUCTION tenants.
  emergencyAlertPhone        String? @map("emergency_alert_phone")
  /// Ordered on-call roster for the ON_CALL_DISPATCH feature: a JSON array of
  /// { name, phone(E.164) }. On an emergency job the receptionist rings these
  /// in order, escalating to the next on no-answer. Empty = nobody to dispatch.
  onCallRoster               Json    @default("[]") @map("on_call_roster")
  /// Seconds to wait for a contact to accept before escalating to the next.
  dispatchEscalationSeconds  Int     @default(120)  @map("dispatch_escalation_seconds")
  /// MISSED_CALL_TEXTBACK feature: message sent when a connected call ends with
  /// no booking and no job captured. Null = platform default. {businessName}.
  missedCallTemplate         String? @db.Text @map("missed_call_template")
  /// SERVICE_AREA feature: the ZIP codes / cities the business serves, as a JSON
  /// string array. The receptionist confirms a job address is in-area before
  /// booking and flags out-of-area calls. Empty = no area configured.
  serviceAreaZips            Json    @default("[]") @map("service_area_zips")
  /// Optional human note shown alongside the area (e.g. "within 25 mi of downtown").
  serviceAreaNote            String? @map("service_area_note")

  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("agent_settings")
}

/// A bookable person or resource within a tenant (a dentist, a stylist, a
/// crew, a chair). A tenant with zero Providers is treated as a single shared
/// resource (the solo case) — appointments carry a null providerId and overlap
/// against each other, exactly as before this model existed. With Providers
/// defined, availability and the double-booking guard are scoped per provider.
model Provider {
  id           String        @id @default(cuid())
  tenantId     String        @map("tenant_id")
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  /// Optional spoken title/role ("Dr.", "Senior Stylist") — cosmetic only.
  title        String?
  active       Boolean       @default(true)
  /// Services this provider is qualified to perform. Empty = can do any service.
  services     Service[]     @relation("ProviderServices")
  appointments Appointment[]
  waitlist     Waitlist[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("providers")
}

/// A bookable service type with its own duration (and the providers qualified
/// to perform it). Drives slot length and narrows the eligible providers when a
/// caller names a service. A tenant with zero Services uses the default slot
/// length and lets any provider take any booking.
model Service {
  id              String        @id @default(cuid())
  tenantId        String        @map("tenant_id")
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  durationMinutes Int           @default(30) @map("duration_minutes")
  description     String?       @db.Text
  active          Boolean       @default(true)
  /// Providers qualified for this service. Empty = any active provider.
  providers       Provider[]    @relation("ProviderServices")
  appointments    Appointment[]
  waitlist        Waitlist[]
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("services")
}

model Appointment {
  id            String            @id @default(cuid())
  tenantId      String            @map("tenant_id")
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// The provider this appointment is with. Null = unassigned / single-resource
  /// business (the solo case). Overlap is checked within the same providerId.
  providerId    String?           @map("provider_id")
  provider      Provider?         @relation(fields: [providerId], references: [id], onDelete: SetNull)
  /// The service booked, when the tenant defines services. Sets the duration.
  serviceId     String?           @map("service_id")
  service       Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  customerName  String            @map("customer_name")
  customerPhone String?           @map("customer_phone")
  /// Why the customer is coming in — spoken by the caller, shown on the calendar.
  reason        String?           @db.Text
  startsAt      DateTime          @map("starts_at")
  endsAt        DateTime          @map("ends_at")
  /// IANA timezone the appointment was booked in (display + slot math).
  timezone      String
  status        AppointmentStatus @default(CONFIRMED)
  source        AppointmentSource @default(VOICE_AGENT)
  /// Provider call id of the booking call (server-side only, like CallLog's).
  externalCallId String?          @map("external_call_id")
  /// Per-provider synced event ids, e.g. { "google": "...", "microsoft": "..." }.
  /// Populated by calendar sync (phase 2); empty object until connected.
  externalEventIds Json           @default("{}") @map("external_event_ids")
  notes         String?           @db.Text
  /// Set only for the public landing-page demo: isolates each visitor's
  /// throwaway bookings under the shared demo tenant. Null for real bookings.
  demoSessionId String?           @map("demo_session_id")
  // ── SMS sent timestamps (null = not yet sent) ────────────────────────────
  confirmationSentAt DateTime?     @map("confirmation_sent_at")
  reminder24hSentAt  DateTime?     @map("reminder_24h_sent_at")
  reminder1hSentAt   DateTime?     @map("reminder_1h_sent_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@index([tenantId, startsAt])
  @@index([providerId])
  @@index([demoSessionId])
  @@map("appointments")
}

/// Someone who wanted an appointment when nothing suitable was open. When a
/// CONFIRMED appointment is cancelled, a slot opens — the oldest WAITING entry
/// that matches (same provider, or any) is texted that a spot is available and
/// flipped to NOTIFIED. Staff add entries by hand from the dashboard; the voice
/// agent can populate it later. Requires a phone number — the whole point is to
/// reach back out.
model Waitlist {
  id            String         @id @default(cuid())
  tenantId      String         @map("tenant_id")
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerName  String         @map("customer_name")
  customerPhone String         @map("customer_phone")
  /// Optional: they want a specific provider. Null = any provider is fine.
  providerId    String?        @map("provider_id")
  provider      Provider?      @relation(fields: [providerId], references: [id], onDelete: SetNull)
  /// Optional: the service they want (sets duration when they eventually book).
  serviceId     String?        @map("service_id")
  service       Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  /// Free-text of what they're after ("any morning next week", "after 5pm").
  note          String?        @db.Text
  status        WaitlistStatus @default(WAITING)
  /// When we last texted them about an opening.
  notifiedAt    DateTime?      @map("notified_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([providerId])
  @@map("waitlist")
}

/// One row per recall (reactivation) text sent. The daily scan checks this to
/// avoid re-texting a lapsed customer within their inactivity window, so a
/// customer hears from us at most once per lapse — never on a loop.
model ReactivationLog {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// E.164 phone the recall text went to.
  phone     String
  sentAt    DateTime @default(now()) @map("sent_at")

  @@index([tenantId, phone, sentAt])
  @@map("reactivation_logs")
}

/// Per-tenant state for an optional, gated product feature (the Tier-1 trades
/// capabilities: on-call dispatch, missed-call text-back, service-area check).
/// Implements the three-layer control model:
///   - `entitled`   — operator grants the feature to this customer (admin only).
///   - `selfManage` — operator lets the customer flip `enabled` themselves.
///   - `enabled`    — the actual on/off (client when self-managed, else admin).
/// Effective = platform-available (e.g. Twilio configured) AND entitled AND
/// enabled, resolved server-side. `feature` is a stable key from the code-side
/// feature registry (domain/features.ts), not a DB enum, so adding a feature
/// needs no migration. Feature-specific config lives in its own model/fields.
model TenantFeature {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Stable feature key, e.g. "ON_CALL_DISPATCH" (see domain/features.ts).
  feature    String
  /// Operator entitlement — the master switch. Off = feature unavailable here.
  entitled   Boolean  @default(false)
  /// Operator grant: may the customer toggle `enabled` from their dashboard?
  selfManage Boolean  @default(false)
  /// The on/off. Client-owned when selfManage is true; operator-owned otherwise.
  enabled    Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, feature])
  @@index([tenantId])
  @@map("tenant_features")
}

/// A job/service request the receptionist captured on a call. For trades, most
/// calls don't map to a fixed appointment slot — they're "burst pipe, send
/// someone" or "I want a quote on a re-pipe." This is where those land as a
/// structured, triageable work item instead of evaporating into a transcript.
/// The customer dashboard shows it as a queue; EMERGENCY rows fire an instant
/// owner SMS. Populated by the captureJobRequest voice tool (or by hand).
model JobRequest {
  id             String            @id @default(cuid())
  tenantId       String            @map("tenant_id")
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerName   String            @map("customer_name")
  customerPhone  String?           @map("customer_phone")
  /// Where the work is. Trades go TO the customer, so the address IS the job.
  serviceAddress String?           @db.Text @map("service_address")
  /// Short label for the work, e.g. "burst pipe", "panel upgrade", "no heat".
  jobType        String?           @map("job_type")
  urgency        JobUrgency        @default(ROUTINE)
  /// What the caller described, in their words — the detail a tech needs.
  description    String?           @db.Text
  /// Caller's stated callback preference, free text ("this afternoon", "after 5").
  preferredCallback String?        @map("preferred_callback")
  status         JobStatus         @default(NEW)
  source         AppointmentSource @default(VOICE_AGENT)
  /// Provider call id of the originating call (server-side only, like CallLog's).
  externalCallId String?           @map("external_call_id")
  /// Staff notes added from the dashboard.
  notes          String?           @db.Text
  /// Set only for the public landing-page demo; null for real jobs.
  demoSessionId  String?           @map("demo_session_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  dispatches     Dispatch[]

  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, urgency])
  @@map("job_requests")
}

/// An on-call dispatch session: the system ringing a trades tenant's on-call
/// roster in order for an EMERGENCY job, escalating to the next person when one
/// doesn't answer/accept, until someone takes it or the list is exhausted (then
/// the owner gets a final alert). Gated by the ON_CALL_DISPATCH feature. The
/// roster is snapshotted at creation so later settings edits don't shift a
/// dispatch already in flight; `token` guards the public Twilio webhooks.
model Dispatch {
  id               String         @id @default(cuid())
  tenantId         String         @map("tenant_id")
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobRequestId     String         @map("job_request_id")
  job              JobRequest     @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  status           DispatchStatus @default(NOTIFYING)
  /// Index into `roster` we're currently ringing.
  currentIndex     Int            @default(0) @map("current_index")
  /// Snapshot of the on-call roster at dispatch time: [{ name, phone }].
  roster           Json
  acceptedName     String?        @map("accepted_name")
  acceptedPhone    String?        @map("accepted_phone")
  /// Random token in the webhook URLs so only Twilio's callbacks for THIS
  /// dispatch can drive it.
  token            String
  /// Seconds to wait for an accept before escalating (also drives the sweep).
  escalateAfterSec Int            @map("escalate_after_sec")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  attempts         DispatchAttempt[]

  @@index([tenantId, status])
  @@index([status, updatedAt])
  @@map("dispatches")
}

/// One ring of one roster contact within a dispatch — the dispatch timeline.
model DispatchAttempt {
  id           String                @id @default(cuid())
  dispatchId   String                @map("dispatch_id")
  dispatch     Dispatch              @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  /// Roster index this attempt corresponds to (matches Twilio callbacks back).
  index        Int
  contactName  String                @map("contact_name")
  contactPhone String                @map("contact_phone")
  status       DispatchAttemptStatus @default(CALLING)
  /// Twilio call SID, for correlation/debugging.
  callSid      String?               @map("call_sid")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  @@unique([dispatchId, index])
  @@index([dispatchId])
  @@map("dispatch_attempts")
}

/// A tenant's connection to a field-service-management system (ServiceTitan,
/// Jobber, Housecall Pro) for the FSM_INTEGRATION feature. Credentials are
/// encrypted at rest (lib/secret-box), like CalendarConnection's OAuth tokens.
/// When `pushJobs` is on, jobs the receptionist captures are pushed into the
/// connected system. One row per provider per tenant.
model FsmConnection {
  id             String              @id @default(cuid())
  tenantId       String              @map("tenant_id")
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider       FsmProvider
  /// AES-256-GCM encrypted credential blob (API key / OAuth tokens), JSON-shaped
  /// per provider. Never returned to clients.
  credentialsEnc String              @db.Text @map("credentials_enc")
  /// Display label for the connected account (e.g. the company/tenant name).
  accountLabel   String?             @map("account_label")
  status         FsmConnectionStatus @default(CONNECTED)
  /// Last error surfaced during a connection test or push, for the UI.
  lastError      String?             @db.Text @map("last_error")
  /// Push captured jobs into this system.
  pushJobs       Boolean             @default(true) @map("push_jobs")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("fsm_connections")
}

/// A tenant's connected external calendar (Google or Microsoft). OAuth tokens
/// are encrypted at rest. One row per provider per tenant — a tenant may link
/// both. Drives two-way sync: VoiceFront bookings are mirrored OUT to the
/// calendar (writeEnabled), and the calendar's busy blocks are read back to
/// suppress availability (blockBusy) so the agent never books over personal
/// time the owner put on their own calendar.
model CalendarConnection {
  id              String           @id @default(cuid())
  tenantId        String           @map("tenant_id")
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider        CalendarProvider
  /// AES-256-GCM encrypted OAuth tokens (see lib/secret-box).
  accessTokenEnc  String           @db.Text @map("access_token_enc")
  refreshTokenEnc String           @db.Text @map("refresh_token_enc")
  /// When the current access token expires; refreshed on use just before.
  expiresAt       DateTime         @map("expires_at")
  /// The connected account (for display + as the Graph/Calendar user context).
  accountEmail    String?          @map("account_email")
  /// Which calendar to write to / read busy from. "primary" by default.
  calendarId      String           @default("primary") @map("calendar_id")
  /// Mirror VoiceFront bookings into this calendar (outbound).
  writeEnabled    Boolean          @default(true) @map("write_enabled")
  /// Block availability using this calendar's busy times (inbound).
  blockBusy       Boolean          @default(true) @map("block_busy")
  /// Last error surfaced during a sync attempt (e.g. revoked access), for the UI.
  lastError       String?          @db.Text @map("last_error")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("calendar_connections")
}

/// A business document the tenant uploaded to power the voice agent's
/// knowledge base (services, pricing, promotions, location, parking, etc.).
/// The actual file lives in Vapi (uploaded + indexed there); we keep only
/// metadata plus `vapiFileId`, which is attached to the assistant as a
/// knowledge-base file so the agent can answer questions from it.
model Document {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Vapi file id returned on upload — the pointer this row mirrors.
  vapiFileId String   @map("vapi_file_id")
  fileName   String   @map("file_name")
  mimeType   String   @map("mime_type")
  sizeBytes  Int      @map("size_bytes")
  /// Vapi processing state: "processing" | "done" | "failed". Until "done"
  /// the file isn't queryable yet; surfaced in the UI so the tenant knows.
  status     String   @default("processing")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("documents")
}

/// A phone number the operator pre-provisions in Vapi (server URL pointed at
/// our inbound webhook) and drops into a shared pool. When a customer goes
/// live, onboarding claims the next available number and writes it onto their
/// AgentSettings.inboundPhoneNumber — so signup is fully self-serve. Releasing
/// a tenant (delete/cancel) returns its number to the pool.
model PooledNumber {
  id               String    @id @default(cuid())
  /// E.164 number, unique across the pool.
  number           String    @unique @map("number")
  /// Vapi phone-number resource id, for future programmatic reconfiguration.
  vapiPhoneId      String?   @map("vapi_phone_id")
  /// ISO country, for at-a-glance filtering (e.g. "US", "CA").
  country          String    @default("US")
  /// The tenant currently holding this number; null = available. Unique so a
  /// tenant can hold at most one pooled number.
  assignedTenantId String?   @unique @map("assigned_tenant_id")
  assignedAt       DateTime? @map("assigned_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@map("pooled_numbers")
}

/// A prospecting lead the founder sourced for outbound sales (platform-level,
/// not tied to a customer tenant). Populated by the lead-gen pipeline: Google
/// Places supplies the business + phone + website; a best-effort website scrape
/// fills in a published business email. Drives the cold-outreach funnel.
model Lead {
  id           String   @id @default(cuid())
  /// Google Places place id — the dedupe key so re-sourcing never duplicates.
  placeId      String?  @unique @map("place_id")
  businessName String   @map("business_name")
  /// The trade + city this lead was sourced for (e.g. "HVAC", "Phoenix, AZ").
  trade        String
  city         String
  phone        String?
  website      String?
  address      String?
  /// Published business email found by scraping the website. Null until found.
  email        String?
  /// How the email was obtained: "website" (scraped) | "manual". Null = none.
  emailSource  String?  @map("email_source")
  /// Google rating + review count — quality signals for prioritising outreach.
  rating       Float?
  reviewCount  Int?     @map("review_count")
  /// Funnel stage: new | emailed | opened | clicked | replied | demoed | won |
  /// dead | unsubscribed. Plain string so stages can evolve without migrations.
  status       String   @default("new")
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt(sort: Desc)])
  @@index([trade, city])
  @@map("leads")
}

/// Operator-editable runtime configuration (API keys, public URLs).
/// Values are AES-256-GCM encrypted; env vars act as fallback defaults.
model PlatformSetting {
  key       String   @id
  valueEnc  String   @db.Text @map("value_enc")
  updatedBy String   @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

/// Platform-operator access levels (distinct from the per-tenant `Role`).
/// ADMIN = full god-mode (keys, billing, managing other admins).
/// SUPPORT = help customers (view, reset passwords, pause/activate) but no
/// access to API keys or admin management.
enum PlatformRole {
  ADMIN
  SUPPORT
}

/// Operators granted access to the founder admin panel, manageable from the UI.
/// Bootstrap superadmins in PLATFORM_ADMIN_EMAILS are always treated as ADMIN
/// and are NOT stored here — so the founder can never be locked out via the UI.
model PlatformAdmin {
  id        String       @id @default(cuid())
  email     String       @unique
  role      PlatformRole @default(SUPPORT)
  /// Email of the admin who granted this access.
  createdBy String       @map("created_by")
  createdAt DateTime     @default(now()) @map("created_at")

  @@map("platform_admins")
}

/// A one-time invitation code the founder issues (after a demo or sales call)
/// so a vetted prospect can create an account. Registration is gated on a
/// valid, unused code: it's looked up case-insensitively, then atomically
/// consumed (usedAt set) inside the signup transaction so it can't be reused
/// or claimed twice in a race. Bootstrap platform admins are exempt.
model AccessCode {
  id             String    @id @default(cuid())
  /// The code the customer types at signup. Stored uppercase; unique.
  code           String    @unique
  /// Optional note so the founder remembers who it's for (e.g. "Riverside Dental").
  label          String?
  /// Optional email it was issued to — a hint shown in the admin list.
  email          String?
  /// Email of the admin who generated it.
  createdBy      String    @map("created_by")
  /// Set when redeemed; null = still valid. Once set, the code is spent.
  usedAt         DateTime? @map("used_at")
  /// Tenant created when the code was redeemed (audit trail).
  usedByTenantId String?   @map("used_by_tenant_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("access_codes")
}

/// Every admin-panel mutation lands here — the founder's undo trail.
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminEmail String   @map("admin_email")
  action     String
  target     String?
  detail     Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("admin_audit_logs")
}

model CallLog {
  id                String     @id @default(cuid())
  tenantId          String     @map("tenant_id")
  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Provider call id — kept server-side only, never exposed to tenants.
  externalCallId    String     @unique @map("external_call_id")
  channel           String     @default("phone")
  callerNumber      String?    @map("caller_number")
  startedAt         DateTime   @map("started_at")
  endedAt           DateTime?  @map("ended_at")
  durationSeconds   Int        @default(0) @map("duration_seconds")
  /// Raw provider cost in cents — internal only.
  providerCostCents Int        @default(0) @map("provider_cost_cents")
  /// Cost shown to the tenant: provider cost + tenant markup, in cents.
  billedCostCents   Int        @default(0) @map("billed_cost_cents")
  markupBpsApplied  Int        @default(0) @map("markup_bps_applied")
  status            CallStatus @default(UNKNOWN)
  endedReason       String?    @map("ended_reason")
  /// When a missed-call text-back was sent for this call (dedupe + idempotency
  /// against provider webhook retries). Null = none sent.
  textBackSentAt    DateTime?  @map("textback_sent_at")
  summary           String?    @db.Text
  transcript        String?    @db.Text
  /// Provider-hosted recording URL — internal only; tenants stream audio
  /// through the platform's masked media proxy instead.
  recordingUrl      String?    @db.Text @map("recording_url")
  createdAt         DateTime   @default(now()) @map("created_at")

  @@index([tenantId, startedAt(sort: Desc)])
  @@map("call_logs")
}

model DemoLead {
  id            String   @id @default(cuid())
  /// Visitor's demo session (links to their isolated calendar).
  demoSessionId String   @map("demo_session_id")
  name          String
  email         String
  phone         String
  /// Visitor's country via IP geolocation ("US", "CA", "GB", etc.). Nullable if lookup fails.
  ipCountry     String?  @map("ip_country")
  /// Phone number's country code ("US", "CA", "GB", etc.). Parsed from the number.
  phoneCountry  String?  @map("phone_country")
  /// Prospect's self-reported industry ("clinic" | "contractor" | "other"),
  /// so the on-screen sample calendar and Ava's framing match their world.
  industry      String   @default("other")
  /// Optional business name the prospect typed on the form. When present it's
  /// shown on the sample calendar instead of the generic industry placeholder.
  businessName  String?  @map("business_name")
  /// Which demo mode they're entering ("web" or "call").
  mode          String   // "web" or "call"
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([demoSessionId])
  @@index([createdAt(sort: Desc)])
  @@map("demo_leads")
}

/// Phones that replied STOP to a tenant's SMS. Checked before every outbound
/// SMS to that tenant — once opted out, no more texts until they reply START.
/// Twilio auto-handles the STOP/START reply flow; we mirror it here so our
/// cron job doesn't retry opted-out numbers before Twilio's webhook fires.
model SmsOptOut {
  id        String   @id @default(cuid())
  /// E.164 phone number that opted out.
  phone     String
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([phone, tenantId])
  @@index([tenantId])
  @@map("sms_opt_outs")
}

/// A caller number a tenant explicitly chose to refuse — the zero-false-positive
/// spam defense. Checked in the assistant-request webhook BEFORE any assistant
/// is returned, so a blocked caller never connects and burns zero minutes.
/// Strictly tenant-scoped: one tenant's block never affects another's callers,
/// and a human always decides what lands here (no automatic blocking), so a real
/// customer can never be silently screened out.
model BlockedCaller {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// E.164 number to refuse.
  phone     String
  /// Optional note shown in the UI ("robocall", "harassment", …).
  reason    String?
  /// User id of the owner/manager who added it (audit trail).
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("blocked_callers")
}

/// One row per call refused at the webhook gate (a blocked number, or — when the
/// tenant opted in — an anonymous caller). These calls never connect, so they
/// cost zero minutes and never become a CallLog. This is the ONLY record of
/// them, so the tenant can see what was screened out and the dashboard can show
/// "spam calls blocked this month".
model ScreenedCallLog {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// The caller we refused (null = anonymous / withheld caller ID).
  callerNumber String?  @map("caller_number")
  /// Why it was refused: "blocked" (on the list) | "anonymous" (opted-in).
  reason       String
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("screened_call_logs")
}

model DemoCall {
  id              String    @id @default(cuid())
  /// Links the call to the visitor's session (and thus their DemoLead).
  demoSessionId   String    @map("demo_session_id")
  externalCallId  String?   @unique @map("external_call_id")
  durationSeconds Int       @default(0) @map("duration_seconds")
  endedReason     String?   @map("ended_reason")
  summary         String?   @db.Text
  transcript      String?   @db.Text
  recordingUrl    String?   @db.Text @map("recording_url")
  startedAt       DateTime? @map("started_at")
  endedAt         DateTime? @map("ended_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([demoSessionId])
  @@index([createdAt(sort: Desc)])
  @@map("demo_calls")
}
